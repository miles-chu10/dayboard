{
  "name": "dayboard",
  "version": "1.3.0-beta.1",
  "private": true,
  "description": "See your whole day at a glance: Google Tasks, Gmail, Google Calendar, and Apple Reminders in one Mac dashboard.",
  "homepage": "https://github.com/miles-chu10/dayboard",
  "license": "GPL-3.0-only",
  "author": "Miles Chu",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "predev": "npm run build:native",
    "build:native": "node scripts/build-reminders-helper.mjs",
    "build": "npm run build:native && electron-vite build",
    "postbuild": "node scripts/generate-notices.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "tsx --test renderer/lib/agenda.test.ts && node --test tests/*.test.mjs",
    "test:e2e": "DAYBOARD_TEST=1 npm run build && playwright test",
    "measure": "node --import tsx scripts/measure-app.mjs",
    "dist": "DAYBOARD_RELEASE=1 npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "package:preview": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --arm64 --publish never",
    "package:test": "DAYBOARD_TEST=1 npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.118",
    "@ai-sdk/google": "^3.0.124",
    "@ai-sdk/openai": "^3.0.114",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^6.0.288",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@radix-ui/colors": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.87.4",
    "@tanstack/react-router": "^1.131.36",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^44.4.4",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.3.0",
    "lucide-react": "^0.542.0",
    "oxfmt": "^0.70.0",
    "radix-ui": "^1.4.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6"
  },
  "overrides": {
    "esbuild": "$esbuild"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild": true,
    "node-pty": true,
    "fsevents": true,
    "electron-winstaller": false
  },
  "productName": "DayBoard"
}
