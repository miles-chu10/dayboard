{
  // Signup-only deployment. Copy to wrangler.jsonc (git-ignored) and replace every placeholder.
  // Licensing routes answer 503 until the Stripe settings from wrangler.example.jsonc are added.
  "name": "dayboard-billing",
  "main": "dist/worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "REPLACE_WITH_API_HOSTNAME", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_D1_NAME",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "SERVICE_ORIGIN": "REPLACE_WITH_API_HTTPS_ORIGIN",
    "SITE_ORIGIN": "REPLACE_WITH_WEBSITE_HTTPS_ORIGIN",
  },
}
