{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci *)",
      "Bash(npm --prefix billing ci *)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format)",
      "Bash(npm run format:check)",
      "Bash(npm run test:billing)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npx oxfmt *)",
      "Bash(npx tsx --test *)",
      "Bash(node --test *)",
      "Bash(node -v)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(shasum *)",
      "Bash(sha256sum *)",
      "Bash(codesign --verify *)",
      "Bash(codesign -dv *)",
      "Bash(xcrun stapler validate *)",
      "Bash(spctl --assess *)",
      "Bash(spctl -a *)"
    ],
    "deny": [
      "Bash(git tag *)",
      "Bash(git push *--tags*)",
      "Bash(git push *--force)",
      "Bash(git push *--force *)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *--delete*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push * v*)",
      "Bash(git push * main)",
      "Bash(git push *:main*)",
      "Bash(*wrangler*)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(gh pr merge *)",
      "Bash(npm publish*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./google-oauth.local.json)",
      "Read(./billing/.dev.vars*)",
      "Read(~/.config/dayboard/**)"
    ]
  }
}
