<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 needs JIT and writable-executable memory under the hardened runtime. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Assistant dictation (hardened runtime blocks the microphone without this). -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- EventKit access for Apple Reminders via the bundled Swift helper. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
  </dict>
</plist>
